# FastAPI server
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=7

# CORS (frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Base URL used in public card links (e.g. copy-link button)
PUBLIC_BASE_URL=http://localhost:8000

# Google OAuth (optional - Google login disabled if unset)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (optional - falls back to local uploads/ if unset)
# Create R2 bucket + API token with Object Read & Write permission
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
